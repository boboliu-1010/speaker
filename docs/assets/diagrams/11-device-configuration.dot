digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.4", ranksep="0.55", splines=line, fontname="PingFang SC", fontsize=23, labelloc=t, label="设备配置与换绑 · Server管理归属和token"];
node [shape=box, style="rounded,filled", fillcolor="#267bb9", color="#2366a0", fontcolor=white, fontname="PingFang SC", fontsize=17, margin="0.22,0.18"];
edge [fontname="PingFang SC", fontsize=13, color="#53667c", fontcolor="#34465d", arrowsize=0.85];
subgraph cluster_transfer { label="3 · 解绑与换绑"; color="#d1dce8"; style=rounded; fontsize=19; margin=20;
u0 [width=3.80, label="原用户处理旧录音\n先上传完或明确确认删除"];
u1 [width=3.80, label="原用户 → Web Server\nHTTP：撤销token / owner=NULL"];
u2 [width=3.80, label="新用户登录并连接Clip\n从步骤1重新绑定，取得新token\n历史成品仍归原用户"];
u0 -> u1 [label="转交前处理完毕"];
u1 -> u2 [label="旧token立即失效"];
}
subgraph cluster_config { label="2 · 配置现有上传功能"; color="#d1dce8"; style=rounded; fontsize=19; margin=20;
c0 [width=3.80, label="浏览器 → Clip设备\nUPLOADAUTO=off，等待空闲"];
c1 [width=4.10, label="浏览器 → Clip设备\n写UPLOADCFG并查询保存结果"];
c2 [width=4.30, label="浏览器 → Clip设备\nUPLOADAUTO=on，查询上传状态"];
c0 -> c1 [label="地址 / UID / token"];
c1 -> c2 [label="configured=true / saved=true"];
}
subgraph cluster_bind { label="1 · 自助绑定"; color="#d1dce8"; style=rounded; fontsize=19; margin=20;
b0 [width=3.40, label="浏览器 → Clip设备\nBLE：IDENTITY读取UID"];
b1 [width=3.80, label="浏览器 → Web Server\nHTTP：登录用户申请绑定UID"];
b2 [width=3.90, label="Web Server\n检查归属，创建或复用token\n返回配置；拒绝覆盖他人"];
b0 -> b1 [label="硬件UID"];
b1 -> b2 [label="核对当前用户 / UID"];
}
}
