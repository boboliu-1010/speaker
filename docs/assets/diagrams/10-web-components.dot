digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.42", ranksep="0.65", splines=polyline, fontname="PingFang SC", fontsize=22, labelloc=t, label="Web Server 内部模块与调用关系"];
node [shape=box, style="filled", fillcolor="#438dd5", color="#2366a0", fontcolor=white, fontname="PingFang SC", fontsize=15, margin="0.18,0.12"];
edge [fontname="PingFang SC", fontsize=12, color="#516379", fontcolor="#34465d", arrowsize=0.8];
subgraph cluster_service {
label="Web Server · 一个进程，一个后台调度循环"; color="#5a7596"; style=dashed; fontsize=20;
boot [width=3.55, label="启动与配置 §5.1\nlifespan / 资源装配 / 角色锁"];
api [width=3.46, label="API与中间件 §5.2–5.3、5.10\n会话 / CSRF / owner / 限流"];
users [width=3.23, label="用户与设备用例 §5.2–5.3\nOIDC / 绑定 / deny-first"];
sql [width=2.79, label="两表数据库适配器 §5.12\naccounts / devices"];
authpub [width=2.98, label="授权文件发布 §5.3\n事务衔接 / epoch / 撤销"];
query [width=2.98, label="查询与媒体用例 §5.10\n一致快照 / Range / 导出"];
export [width=2.72, label="导出渲染 §5.10\n确定性VTT / Markdown"];
worker [width=3.58, label="后台调度 §5.6\n领取 / attempt / 重试 / 提交"];
importer [width=2.70, label="来源导入 §5.4\n去重 / 会话聚合"];
decode [width=3.05, label="音频解码 §5.7\n受限临时子进程 / 双盘发布"];
asr [width=3.93, label="ASR客户端 §5.8\n固定socket / 配置冻结 / 结果校验"];
merge [width=3.21, label="时间轴与快照 §5.9\n样本偏移 / 覆盖 / 版本复核"];
repair [width=3.15, label="副本修复 §5.13\n独立repair预算 / 保留文字"];
repo [width=4.43, label="文件仓储 §5.5\nports / flock / 原子JSON / 提交标识"];
}
browser [width=2.82, shape=box, fillcolor="#e8edf3", color="#8b9bb0", fontcolor="#24354a", label="用户 / Web页面 §5.11\n同源HTTPS / TCP 9529"];
google [width=2.82, shape=box, fillcolor="#e8edf3", color="#8b9bb0", fontcolor="#24354a", label="Google OIDC\n外部登录身份服务"];
clip [width=3.95, shape=box, fillcolor="#e8edf3", color="#8b9bb0", fontcolor="#24354a", label="Clip Server · 内置ASR\nUnix socket HTTP / 不访问数据库"];
db [width=2.82, shape=cylinder, fillcolor="#e8edf3", color="#8b9bb0", fontcolor="#24354a", label="SQLite\n仅accounts / devices"];
authfile [width=2.82, shape=cylinder, fillcolor="#e8edf3", color="#8b9bb0", fontcolor="#24354a", label="设备授权文件\nWeb写 / Clip只读"];
sources [width=2.82, shape=cylinder, fillcolor="#e8edf3", color="#8b9bb0", fontcolor="#24354a", label="ready与结束事件\nClip发布 / Web只读"];
state [width=3.53, shape=cylinder, fillcolor="#e8edf3", color="#8b9bb0", fontcolor="#24354a", label="录音 / job / transcript文件\nWeb独占业务写入"];
audio [width=2.82, shape=cylinder, fillcolor="#e8edf3", color="#8b9bb0", fontcolor="#24354a", label="双盘raw与WAV\n受控读取 / 校验 / 发布"];
browser -> api [label="HTTPS / API"];
api -> users [label="用户 / 设备请求"];
users -> google [label="OIDC HTTPS"];
users -> sql [label="用户与设备仓储接口"];
sql -> db [label="SQL事务"];
users -> authpub [label="发布 / 撤销授权"];
authpub -> authfile [label="deny-first / 原子写"];
api -> query [label="录音 / 媒体 / 导出请求"];
query -> repo [label="鉴权 / 捕获快照"];
query -> export [label="按快照渲染"];
query -> audio [label="同句柄Range读取"];
worker -> importer [label="扫描导入"];
importer -> sources [label="只读 / 验证"];
importer -> repo [label="聚合 / 补建job"];
worker -> repo [label="领取 / 提交 / 对账"];
worker -> decode [label="解码job"];
decode -> audio [label="raw读取 / 双盘WAV写入"];
worker -> asr [label="ASR job"];
asr -> clip [label="health / transcribe / 校验结果"];
worker -> merge [label="汇总版本"];
merge -> repo [label="读取片段 / 提交快照"];
worker -> repair [label="repair job"];
repair -> audio [label="复制 / 校验"];
repair -> repo [label="修复引用"];
repo -> state [label="锁内短读写 / 原子发布"];
boot -> api [style=dashed, label="装配/生命周期", constraint=false];
boot -> worker [style=dashed, label="装配/生命周期", constraint=false];
boot -> sql [style=dashed, label="装配/生命周期", constraint=false];
boot -> repo [style=dashed, label="装配/生命周期", constraint=false];
}
