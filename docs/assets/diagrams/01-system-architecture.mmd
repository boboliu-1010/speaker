C4Container
    title ReSpeaker Clip — C4 Container Diagram

    Person(user, "用户 / 浏览器", "登录、配置设备、播放与导出")
    System_Ext(device, "ReSpeaker Clip", "原始 Opus 与会话声明")
    System_Ext(google, "Google OIDC", "外部身份服务")

    System_Boundary(speaker, "Speaker Server") {
        Container(clip, "Clip Server", "Python / DTLS + FunASR", "设备验证、收件与内置ASR\n不连接数据库")
        Container(web, "Web Server", "Python / FastAPI + 静态 Web", "用户设备、API与一个后台循环\n解码、调用ASR、播放与导出")
        ContainerDb(state, "共享状态文件", "JSON / 本机文件系统 / flock", "设备授权；progress、ready与会话事件\n录音、job、识别原文与健康状态")
        ContainerDb(database, "用户与设备数据库", "SQLite", "accounts / devices 两张表\n仅 Web Server 访问")
        ContainerDb(audio, "音频文件存储", "文件系统 / 双副本", "原始 raw Opus / 分段 WAV\n元数据独立于音频盘保存")
    }

    Rel(user, web, "使用网页和 API", "HTTPS / TCP 9529")
    Rel(device, clip, "上传 Opus 与会话声明", "DTLS / UDP 9528")
    Rel(web, google, "交换并验证登录身份", "OIDC / HTTPS")
    Rel(web, clip, "调用内置ASR，读取逐句结果", "本机 Unix socket / HTTP")
    BiRel(clip, state, "读设备授权；写收件、ready及会话事件", "文件 I/O + flock")
    BiRel(web, state, "读 ready/声明；写授权、录音、job及原文", "文件 I/O + flock")
    BiRel(clip, audio, "写原始 raw；只读 WAV 供内置ASR", "文件 I/O")
    BiRel(web, audio, "读取 raw；写入并读取 WAV", "文件 I/O")
    Rel(web, database, "查询和更新用户与设备", "SQL / SQLite")

