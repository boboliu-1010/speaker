{
  "theme": "base",
  "htmlLabels": false,
  "themeVariables": {
    "fontFamily": "PingFang SC, Microsoft YaHei, Noto Sans CJK SC, Arial, sans-serif",
    "primaryColor": "#e7f2ef",
    "primaryTextColor": "#1b3433",
    "primaryBorderColor": "#7a9c96",
    "lineColor": "#607a78",
    "secondaryColor": "#f4f7f9",
    "tertiaryColor": "#ffffff",
    "actorBkg": "#edf3f2",
    "actorBorder": "#7a9c96",
    "actorTextColor": "#1b3433"
  },
  "flowchart": {
    "htmlLabels": false,
    "curve": "linear"
  },
  "sequence": {
    "useMaxWidth": true,
    "wrap": true
  },
  "er": {
    "minEntityWidth": 190,
    "minEntityHeight": 60,
    "entityPadding": 14
  }
}
