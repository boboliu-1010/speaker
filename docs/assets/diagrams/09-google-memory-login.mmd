flowchart TB
    Web["浏览器：Google 登录"] --> Start["一次性登录状态：5 分钟"]
    Start --> Google["Google OAuth / OIDC + PKCE"]
    Google --> Verify["校验回调、浏览器绑定与 Google 身份"]
    Verify --> User["SQLite：基本用户与稳定身份"]
    User --> Session["内存会话：闲置 24 小时 / 最长 7 天"]
    Session --> Cookie["浏览器：安全会话 Cookie"]
    Cookie --> Owner["每次请求：用户状态 + owner 检查"]
    User --> Owner
    Start -.-> Temp["临时状态一次消费；Google token 使用后丢弃"]
    Restart["退出 / 过期 / Server 重启"] --> Clear["清除会话，重新登录"]
    Clear -.-> Keep["用户、设备、录音与后台任务保留"]
