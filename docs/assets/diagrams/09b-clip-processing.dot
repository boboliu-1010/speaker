digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.4", ranksep="0.55", splines=line, fontname="PingFang SC", fontsize=23, labelloc=t, label="Clip Server · 单个片段的处理顺序"];
