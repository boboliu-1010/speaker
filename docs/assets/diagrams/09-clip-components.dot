digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.42", ranksep="0.7", splines=polyline, fontname="PingFang SC", fontsize=22, labelloc=t, label="Clip Server：接入、处理与完整录音发布"];
node [shape=box, style=filled, fillcolor="#438dd5", color="#2366a0", fontcolor=white, fontname="PingFang SC", fontsize=15, margin="0.18,0.12"];
edge [fontname="PingFang SC", fontsize=12, color="#516379", fontcolor="#34465d", arrowsize=0.8];
subgraph cluster_service { label="Clip Server · 一个进程，一个处理循环"; color="#5a7596"; style=dashed; fontsize=20;
boot [width=2.84, label="启动与生命周期 §4.1\n收件 / 调度 / 资源退出"];
protocol [width=2.90, label="DTLS与协议 §4.2\n帧解析 / 上传与完成消息"];
auth [width=3.22, label="身份验证 §4.3\n本地授权 / owner / epoch"];
upload [width=2.91, label="原件收件 §4.4\n续传 / hash / 容量预留"];
group [width=3.26, label="recording聚合 §4.5\n段号 / 结束声明 / 收齐判定"];
repo [width=3.27, label="录音与job仓储 §4.6\n状态 / attempt / 原子提交"];
worker [width=2.84, label="调度与重试 §4.7\n依赖检查 / 执行 / 对账"];
decode [width=2.58, label="Opus解码 §4.8\n原件 → 分段PCM WAV"];
asr [width=3.10, label="内置转写 §4.9\n模型推理 / 逐句文本与时间"];
merge [width=2.82, label="整条录音合并 §4.10\n连续WAV / 完整VTT与MD"];
publish [width=3.12, label="成品发布 §4.11\n三件套清单 / 原子current"];
health [width=2.69, label="报告与健康 §4.12\n收件与处理状态 / 队列"];
}
device [shape=box, width=2.26, fillcolor="#e8edf3", color="#8b9bb0", fontcolor="#24354a", label="ReSpeaker Clip\nDTLS / UDP 9528"];
fs [shape=cylinder, width=3.67, fillcolor="#e8edf3", color="#8b9bb0", fontcolor="#24354a", label="本机文件系统\n授权 / 原件 / recording与job\n中间结果 / 完整WAV-VTT-MD"];
device -> protocol [label="上传 / 录完声明"];
protocol -> auth [label="验证身份"];
auth -> fs [label="只读授权"];
protocol -> upload [label="已验证上传"];
protocol -> group [label="已认证session_end"];
upload -> auth [label="接受原件前复核"];
upload -> fs [label="写progress / raw / ready"];
upload -> group [label="完整来源 / 结束声明"];
group -> repo [label="聚合 / 创建依赖job"];
repo -> fs [label="读写内部状态"];
worker -> repo [label="领取 / 提交 / 对账"];
worker -> decode [label="decode任务"];
decode -> fs [label="读raw / 写分段WAV"];
worker -> asr [label="ASR任务"];
asr -> fs [label="读WAV与离线模型 / 写转写"];
worker -> merge [label="收齐后合并与格式生成"];
merge -> fs [label="读片段 / 生成完整三件套"];
worker -> publish [label="发布已验证版本"];
publish -> repo [label="核对执行及输入版本"];
publish -> fs [label="发布清单 / 原子切current"];
worker -> health [label="队列及执行状态"];
protocol -> health [label="接入状态"];
health -> fs [label="写报告及自身状态"];
boot -> protocol [style=dashed, label="启动 / 生命周期", constraint=false];
boot -> worker [style=dashed, label="启动 / 生命周期", constraint=false];
boot -> health [style=dashed, label="启动 / 生命周期", constraint=false];
}
